# 必填：JWT 签名密钥。生产环境请使用强随机值，例如:
# openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret

# 生产 HTTPS 必须开启；本地直接 python main.py 调试时可不设置或设为 0
COOKIE_SECURE=1

# CORS 白名单，逗号分隔
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://evanesce.site,https://www.evanesce.site

# 上传与限流
MAX_UPLOAD_SIZE=52428800
ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.flac,.ogg,.m4a,.aac
RATE_LIMIT_SEARCH=30
RATE_LIMIT_AUTH=100
RATE_LIMIT_GENERAL=300
