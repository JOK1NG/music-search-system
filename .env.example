# ============================================
# VECTORTUNE - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# docker-compose will automatically load variables from .env

# ------------------------------------------
# JWT Authentication
# ------------------------------------------
# Secret key for signing JWT tokens. MUST be changed in production.
# Generate a strong random key, e.g.:  openssl rand -hex 32
JWT_SECRET=vectortune-dev-secret-change-in-production

# ------------------------------------------
# Reverse Proxy / Domain
# ------------------------------------------
# The domain(s) Caddy will serve and auto-provision TLS certificates for.
SITE_DOMAIN=evanesce.site
