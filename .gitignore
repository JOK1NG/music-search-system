# Python 虚拟环境
.venv/

# macOS 系统文件
.DS_Store

# 音频数据集
data/raw

# 音频数据集训练用的 30 秒波形 NumPy 数组缓存
data/waveform_cache_30s/
data/raw.zip

# 毕业设计文档
（已压缩）Gemini-毕业设计_9-419.pdf

# VSCode 配置
.vscode/settings.json

# Python 字节码缓存（所有版本）
__pycache__/
*.pyc
*.pyo

# IDE 配置
.idea/

# 数据库文件
music_hash.db

# 模型权重：默认忽略训练中间产物，只保留 V1/V2/V3 最佳权重
checkpoints/*
!checkpoints/hash_model_v1_epoch_15_best.pth
!checkpoints/hash_model_v2_epoch_10_best.pth
!checkpoints/hash_model_v3_epoch_9_best.pth

# 实验日志：默认忽略，只保留论文/答辩关键结果日志
logs/*
!logs/diag_v2_final.log
!logs/e2e_v2_final_n10.log
!logs/rebuild_v2_final.log
!logs/diag_v3.log
!logs/e2e_v3.log
!logs/e2e_v3_n10.log
!logs/rebuild_v3.log
!logs/select_v3.log

# 文档备份
docs/

# 临时测试脚本
_test_cross_song_hamming.py

# Docker 离线依赖包（仅部署时使用，不入库）
wheels/

# 本地/生产环境变量，包含 JWT_SECRET 等敏感信息
.env
